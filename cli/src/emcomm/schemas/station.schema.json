{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "radio"],
  "properties": {
    "name": {"type": "string", "pattern": "\\A[a-z0-9][a-z0-9-]{0,7}\\Z"},
    "radio": {"type": "string"},
    "ptt": {"enum": ["cat", "rts", "dtr", "vox"]},
    "cat": {"$ref": "#/$defs/match"},
    "audio": {"$ref": "#/$defs/match"}
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor_id", "product_id"],
      "properties": {
        "vendor_id": {"type": "string", "pattern": "\\A[0-9a-f]{4}\\Z"},
        "product_id": {"type": "string", "pattern": "\\A[0-9a-f]{4}\\Z"},
        "serial": {"type": "string", "pattern": "\\A[^\"\\\\*?\\[\\]|\\x00-\\x1f\\x7f]*\\Z"},
        "interface": {"type": "string", "pattern": "\\A[0-9a-f]{2}\\Z"}
      }
    }
  }
}
